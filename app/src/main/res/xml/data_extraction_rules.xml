<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Alpha policy: cloud backup is disabled for all app-managed data. -->
        <exclude domain="root" path="." />
    </cloud-backup>

    <device-transfer>
        <!-- Alpha policy: device transfer is disabled for all app-managed data. -->
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
